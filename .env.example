# Express Auto Bike Management System — Environment Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# DEPLOYMENT_MODE controls which Docker Compose file is used:
#
#   development  → docker-compose-local.yml    (laptop, hot reload)
#   tunnel       → docker-compose-trycloudflare.yml  (shop PC, free public URL)
#   server       → docker-compose-server.yml   (VPS with domain + auto SSL)
#
# First time on any machine:  ./deploy-first-time.sh
# Daily use:                  ./deploy.sh up

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
DEPLOYMENT_MODE=development

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_DB=express_auto_bike
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres          # Use a strong password in tunnel/server mode
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/express_auto_bike

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# DJANGO
# =============================================================================
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-random-50-character-string-before-going-live

DEBUG=1                             # Set to 0 in tunnel/server mode
DJANGO_SETTINGS_MODULE=express_auto_bike.settings

ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

BACKEND_PORT=8000
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# =============================================================================
# NEXT.JS FRONTEND
# =============================================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Express Auto Bike Management
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_OFFLINE_ENABLED=true
NEXT_PUBLIC_BARCODE_SCANNER_ENABLED=true

# =============================================================================
# GOOGLE OAUTH  (optional)
# Leave empty to use email/password login only.
# Setup guide: https://console.cloud.google.com/ → APIs & Services → Credentials
# Create OAuth 2.0 Client ID (Web application type).
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback/
# For tunnel/server mode, also add your public URL to the redirect URIs.
# =============================================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=      # Same value as GOOGLE_OAUTH_CLIENT_ID

# =============================================================================
# EMAIL NOTIFICATIONS  (optional)
# Leave empty to skip email alerts (notifications still appear in-app).
# Use a Gmail App Password — NOT your Gmail account password.
# Create one: myaccount.google.com → Security → 2-Step Verification → App Passwords
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL="Express Auto <your-email@gmail.com>"
FRONTEND_URL=http://localhost:3000  # Update to your public URL in tunnel/server mode

# =============================================================================
# WHATSAPP CLICK-TO-CHAT  (optional)
# Country code + number, no + or spaces. Example: 919876543210 for India (+91).
# =============================================================================
WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# =============================================================================
# TUNNEL MODE  (auto-managed by deploy.sh — do not set manually)
# deploy.sh fills these automatically each time the tunnel starts.
# =============================================================================
TUNNEL_FRONTEND_URL=
TUNNEL_BACKEND_URL=

# =============================================================================
# SERVER MODE  (fill these when moving to a VPS)
# Prerequisites before running ./deploy-first-time.sh in server mode:
#   1. Domain A record pointed to your server IP (at your DNS provider)
#   2. Ports 80 and 443 open in your server firewall/security group
# =============================================================================
FRONTEND_DOMAIN=yourdomain.com
BACKEND_DOMAIN=api.yourdomain.com
ACME_EMAIL=your-email@gmail.com    # Receives SSL certificate expiry alerts

# =============================================================================
# SECURITY  (managed by deploy.sh per mode — safe to leave as-is)
# =============================================================================
SECURE_SSL_REDIRECT=0
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
CSRF_COOKIE_HTTPONLY=1
X_FRAME_OPTIONS=DENY
