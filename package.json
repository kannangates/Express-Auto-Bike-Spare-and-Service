{
  "name": "express-auto-bike-management-system",
  "version": "1.0.0",
  "description": "Production-grade full-stack PWA for bike spare parts and service management",
  "private": true,
  "workspaces": [
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python3 manage.py runserver",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && python3 manage.py collectstatic --noinput",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && pytest",
    "test:property": "npm run test:property:frontend && npm run test:property:backend",
    "test:property:frontend": "cd frontend && npm run test:property",
    "test:property:backend": "cd backend && pytest tests/property/",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && flake8 .",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "cd frontend && prettier --write .",
    "format:backend": "cd backend && black . && isort .",
    "type-check": "npm run type-check:frontend && npm run type-check:backend",
    "type-check:frontend": "cd frontend && npm run type-check",
    "type-check:backend": "cd backend && mypy .",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "migrate": "cd backend && python3 manage.py migrate",
    "makemigrations": "cd backend && python3 manage.py makemigrations",
    "createsuperuser": "cd backend && python3 manage.py createsuperuser",
    "collectstatic": "cd backend && python3 manage.py collectstatic --noinput",
    "shell": "cd backend && python3 manage.py shell",
    "celery:worker": "cd backend && celery -A express_auto_bike worker -l info",
    "celery:beat": "cd backend && celery -A express_auto_bike beat -l info --scheduler django_celery_beat.schedulers:DatabaseScheduler",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && pip install -r requirements.txt",
    "clean": "npm run clean:frontend && npm run clean:backend",
    "clean:frontend": "cd frontend && rm -rf .next node_modules",
    "clean:backend": "cd backend && find . -name '*.pyc' -delete && find . -name '__pycache__' -delete",
    "spell-check": "cspell \"**/*.{ts,tsx,js,jsx,py,md,json}\"",
    "spell-check:fix": "cspell \"**/*.{ts,tsx,js,jsx,py,md,json}\" --wordsOnly --unique --gitignore > .cspell-words.txt"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cspell": "^8.14.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test"
    }
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "cd frontend && npm run lint",
      "cd frontend && prettier --write"
    ],
    "backend/**/*.py": [
      "cd backend && black",
      "cd backend && isort",
      "cd backend && flake8"
    ],
    "**/*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/express-auto-bike-management-system.git"
  },
  "keywords": [
    "bike-management",
    "inventory-system",
    "pwa",
    "nextjs",
    "django",
    "barcode-scanning",
    "service-management",
    "spare-parts",
    "full-stack",
    "typescript",
    "python"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-username/express-auto-bike-management-system/issues"
  },
  "homepage": "https://github.com/your-username/express-auto-bike-management-system#readme"
}