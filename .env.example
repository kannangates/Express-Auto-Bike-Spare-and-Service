# Express Auto Bike Management System - Environment Configuration
# This is the ONLY .env file - used by all services
# Copy this file to .env and update with your values

# =============================================================================
# DEPLOYMENT MODE (REQUIRED - CHOOSE ONE)
# =============================================================================
# Options: development, production, tunnel
# - development: Local testing on your computer
# - production: VPS/Server with your own domain
# - tunnel: Free hosting on laptop with Cloudflare Tunnel
DEPLOYMENT_MODE=development

# =============================================================================
# COMMON SETTINGS (USED BY ALL MODES)
# =============================================================================

# Database Configuration
POSTGRES_DB=express_auto_bike
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/express_auto_bike

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_TTL=3600

# Django Backend Configuration
SECRET_KEY=change-this-to-a-random-50-character-string-in-production
BACKEND_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
DJANGO_SETTINGS_MODULE=express_auto_bike.settings

# API Configuration
API_VERSION=v1
API_TITLE=Express Auto Bike Management API
API_DESCRIPTION=API for bike spare parts and service management

# Next.js Frontend Configuration
NODE_ENV=development
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=Express Auto Bike Management
NEXT_PUBLIC_APP_VERSION=1.0.0

# PWA Configuration
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_OFFLINE_ENABLED=true

# Feature Flags
NEXT_PUBLIC_BARCODE_SCANNER_ENABLED=true
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=true
NEXT_PUBLIC_OFFLINE_SYNC_ENABLED=true
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_MOCK_API=false

# Authentication - Google OAuth (OPTIONAL - All Modes)
# Get credentials from: https://console.cloud.google.com/
# Leave empty to use simple email/password authentication only
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Email Configuration (OPTIONAL - All Modes)
# For email notifications - use Gmail App Password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL="Express Auto <care@gmail.com>"
SERVER_EMAIL=noreply@expressauto.com
FRONTEND_URL=http://localhost:3000

# WhatsApp Click-to-Chat (personal number, no API needed)
# Format: country code + number, no + or spaces (e.g. 919876543210 for India)
WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_NUMBER=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# File Upload Configuration
MEDIA_URL=/media/
MEDIA_ROOT=media/
STATIC_URL=/static/
STATIC_ROOT=staticfiles/
MAX_UPLOAD_SIZE=10485760

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# Monitoring & Error Tracking (OPTIONAL - All Modes)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_TRACKING_ID=

# Backup Configuration
BACKUP_RETENTION_DAYS=7

# =============================================================================
# DEVELOPMENT MODE SETTINGS (ONLY USED WHEN DEPLOYMENT_MODE=development)
# =============================================================================
# These are already set in COMMON SETTINGS above
# Just keep DEPLOYMENT_MODE=development
# Access at: http://localhost:3000

DEBUG=1
RESTART_POLICY=no
FRONTEND_DOCKERFILE=Dockerfile
FRONTEND_COMMAND=npm run dev

# =============================================================================
# TUNNEL MODE SETTINGS (ONLY USED WHEN DEPLOYMENT_MODE=tunnel)
# =============================================================================
# For free hosting on your laptop with Cloudflare Tunnel
# Two options: Temporary (auto-updates) or Permanent (one-time setup)

# Option 1: Temporary Tunnel (Default - No Setup Needed)
# - Just run: ./deploy.sh
# - URL changes on restart
# - .env auto-updates with new URL
# - Leave CLOUDFLARE_TUNNEL_NAME empty

# Option 2: Permanent Tunnel (Optional - One-Time Setup)
# - Run once: ./setup-tunnel-simple.sh
# - URL never changes
# - Set CLOUDFLARE_TUNNEL_NAME below

# Tunnel URLs (Auto-updated by deploy.sh for temporary tunnel)
TUNNEL_FRONTEND_URL=https://your-tunnel-id.trycloudflare.com
TUNNEL_BACKEND_URL=https://api-your-tunnel-id.trycloudflare.com

# Permanent Tunnel Name (Leave empty for temporary tunnel)
# Set this ONLY if you ran ./setup-tunnel-simple.sh
CLOUDFLARE_TUNNEL_NAME=

# Tunnel Mode Overrides
# DEBUG=0  # Uncomment for tunnel mode
# RESTART_POLICY=unless-stopped  # Uncomment for tunnel mode

# =============================================================================
# PRODUCTION MODE SETTINGS (ONLY USED WHEN DEPLOYMENT_MODE=production)
# =============================================================================
# For VPS/Server deployment with your own domain

# SSL/TLS Configuration (Required for production)
ACME_EMAIL=your-email@example.com
BACKEND_DOMAIN=api.yourdomain.com
FRONTEND_DOMAIN=yourdomain.com

# Production Overrides (Uncomment when using production mode)
# DEBUG=0
# RESTART_POLICY=unless-stopped
# POSTGRES_PASSWORD=create-a-strong-password-here
# SECRET_KEY=generate-a-random-50-character-string-here

# Security Settings (Production)
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
SECURE_CONTENT_TYPE_NOSNIFF=1
SECURE_BROWSER_XSS_FILTER=1
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
CSRF_COOKIE_HTTPONLY=1
SESSION_COOKIE_AGE=1209600

# Rate Limiting (Production)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Cloud Backup (OPTIONAL - Production)
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# =============================================================================
# DEVELOPMENT TOOLS (ONLY FOR DEVELOPMENT MODE)
# =============================================================================
DJANGO_EXTENSIONS_ENABLED=1
DEBUG_TOOLBAR_ENABLED=1

# =============================================================================
# QUICK REFERENCE
# =============================================================================
# 
# DEVELOPMENT MODE (Local Testing):
#   DEPLOYMENT_MODE=development
#   Access: http://localhost:3000
#   No other changes needed!
#
# TUNNEL MODE (Free Hosting on Laptop):
#   DEPLOYMENT_MODE=tunnel
#   DEBUG=0
#   Option A: Temporary tunnel (just run ./deploy.sh)
#   Option B: Permanent tunnel (run ./setup-tunnel-simple.sh once)
#
# PRODUCTION MODE (VPS/Server):
#   DEPLOYMENT_MODE=production
#   DEBUG=0
#   BACKEND_DOMAIN=api.yourdomain.com
#   FRONTEND_DOMAIN=yourdomain.com
#   ACME_EMAIL=your-email@example.com
#   SECRET_KEY=random-50-chars
#   POSTGRES_PASSWORD=strong-password
#
# =============================================================================
