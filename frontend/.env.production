# Production Environment Variables for Vercel Deployment
# These will be overridden by Vercel environment variables

# Application Configuration
NEXT_PUBLIC_APP_NAME="Express Auto Bike Management System"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# API Configuration - Will be set via Vercel environment variables
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
NEXT_PUBLIC_WS_URL="wss://api.yourdomain.com"

# Google OAuth Configuration - Will be set via Vercel environment variables
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# PWA Configuration
NEXT_PUBLIC_PWA_ENABLED="true"
NEXT_PUBLIC_OFFLINE_ENABLED="true"

# Feature Flags
NEXT_PUBLIC_BARCODE_SCANNER_ENABLED="true"
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED="true"
NEXT_PUBLIC_OFFLINE_SYNC_ENABLED="true"

# Production Configuration
NEXT_PUBLIC_DEBUG_MODE="false"
NEXT_PUBLIC_MOCK_API="false"

# Environment
NODE_ENV="production"

# Analytics (Optional) - Will be set via Vercel environment variables
NEXT_PUBLIC_GA_TRACKING_ID=""
NEXT_PUBLIC_SENTRY_DSN=""